NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sistema_prestamos
# Para Supabase en Render: true por defecto. Usar false solo como alternativa temporal para Session Pooler sin CA disponible.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Opcional: certificado CA PEM de Supabase, con saltos de línea como \n. Fuerza validación de certificado.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
CORS_ORIGIN=http://localhost:4200,https://localhost
LOG_LEVEL=info
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
